{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://REPLACE-WITH-YOUR-API-HOST" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://REPLACE-WITH-YOUR-API-HOST" }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
