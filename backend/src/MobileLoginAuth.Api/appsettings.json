{
  "ConnectionStrings": {
    "Default": "Data Source=mobileloginauth.db"
  },
  "Jwt": {
    "Issuer": "MobileLoginAuth",
    "Audience": "MobileLoginAuth.Mobile",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "RabbitMq": {
    "Transport": "RabbitMq",
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@mobileloginauth.local",
    "FromName": "MobileLoginAuth"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "MassTransit": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
