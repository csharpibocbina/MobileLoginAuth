# Copy to deploy/.env on the server and fill in. Never commit the real .env.

# Public hostname pointing (DNS A record) at this server, e.g. api.mobileloginauth.com
# No domain yet? Free option: api.<server-ip-with-dashes>.sslip.io, e.g. api.178-128-56-88.sslip.io
API_DOMAIN=api.example.com

# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

# RabbitMQ credentials (internal only, pick any strong values)
RABBITMQ_USER=mla
RABBITMQ_PASSWORD=

# Real SMTP provider (e.g. Brevo, Mailgun, SendGrid SMTP, Amazon SES, Gmail app password)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=MobileLoginAuth
